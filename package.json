{
  "name": "abl-pixelforge",
  "version": "1.0.0",
  "description": "Compresor y optimizador profesional de imágenes para Windows 11 desarrollado por Aritz Bahamonde Larxé.",
  "main": "src/main/index.js",
  "author": "Aritz Bahamonde Larxé",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite --config vite.config.mjs",
    "build:renderer": "vite build --config vite.config.mjs",
    "start": "electron src/main/index.js",
    "pack:win": "npm run build:renderer && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.aritzbahamondelarxe.pixelforge",
    "productName": "PIXELFORGE",
    "copyright": "© 2026 Aritz Bahamonde Larxé. Todos los derechos reservados.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PIXELFORGE",
      "artifactName": "PIXELFORGE-Setup.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McFully/abl-pixelforge.git"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@jsquash/oxipng": "^2.3.0",
    "sharp": "^0.35.5"
  }
}
